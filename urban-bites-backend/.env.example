# Database Credentials (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/UrbanBitesDB?createDatabaseIfNotExist=true&useSSL=false
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# Cloudinary Media CDN API Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Stateless Token Signing Secret Key (Minimum 256 bits)
JWT_SECRET_KEY=your_super_secret_jwt_signing_key_minimum_256_bits_long

# Razorpay Test Gateway Keys
RAZORPAY_TEST_ID=your_razorpay_key_id
RAZORPAY_TEST_SECRET=your_razorpay_key_secret

# CORS Allowed Frontend Origins / URLs
FRONTEND_USER_URL=http://localhost:5174/
FRONTEND_ADMIN_URL=http://localhost:5173/

# System Administrator Accounts
ADMIN_PRIMARY_EMAIL=admin@yourdomain.com
ADMIN_PRIMARY_PASSWORD=your_secure_primary_password

ADMIN_DEMO_EMAIL=demo.admin@yourdomain.com
ADMIN_DEMO_PASSWORD=your_secure_demo_password
